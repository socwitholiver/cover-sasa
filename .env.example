# Copy this file to ".env" and fill in your keys.

# The backend reads ANTHROPIC_API_KEY automatically.
# Leave it unset to run in DEMO mode (pre-written answers, full app works).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the backend port (frontend proxy expects 3001)
# PORT=3001

# Google Maps key for the Hospital Finder (frontend, Vite exposes VITE_* vars).
# A demo key is inlined in src/config.js so the app works without this.
# In production, set your own key here and restrict it by HTTP referrer.
# VITE_GOOGLE_MAPS_KEY=AIza...
